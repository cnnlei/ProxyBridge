+static BOOL make_key(
+    CONNECTION_KEY *key,
+    int protocol,
+    ADDRESS_FAMILY family,
+    const UINT8 *address,
+    UINT16 port)
+{
+    SIZE_T size =
+        family == AF_INET ? CONNECTION_IPV4_ADDRESS_SIZE :
+        CONNECTION_IPV6_ADDRESS_SIZE;
+
+    return connection_key_set(
+        key,
+        protocol,
+        family,
+        address,
+        size,
+        port);
