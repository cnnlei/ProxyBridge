+    CHECK(connection_table_is_tracked(table, &keys[1]), "fresh entry removed");
+    CHECK(!connection_table_is_tracked(table, &keys[2]), "stale middle remains");
+    CHECK(!connection_table_is_tracked(table, &keys[3]), "stale head remains");
