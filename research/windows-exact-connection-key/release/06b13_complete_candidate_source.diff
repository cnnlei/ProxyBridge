+BOOL connection_key_bucket_index(
+    const CONNECTION_KEY *key,
+    UINT32 *bucket_index)
+{
+    if (bucket_index == NULL) {
+        return FALSE;
+    }
+
+    *bucket_index = 0u;
+    if (!connection_key_is_valid(key)) {
+        return FALSE;
+    }
+
+    *bucket_index =
+        connection_key_hash(key) & (CONNECTION_HASH_SIZE - 1u);
+    return TRUE;
+}
